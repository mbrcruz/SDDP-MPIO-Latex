\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Comparação esquemática entre os protocolos \textit  {Eager} e \textit  {Rendezvous} em comunicação MPI ponto a ponto. No \textit  {Eager}, o emissor transmite os dados imediatamente, sem negociação prévia; no \textit  {Rendezvous}, há uma etapa de \textit  {handshake} entre emissor e receptor antes da transferência efetiva, eliminando a necessidade de \textit  {buffers} intermediários.}}{6}{figure.2.1}\protected@file@percent }
\newlabel{fig:eager_rendezvous}{{2.1}{6}{Comparação esquemática entre os protocolos \textit {Eager} e \textit {Rendezvous} em comunicação MPI ponto a ponto. No \textit {Eager}, o emissor transmite os dados imediatamente, sem negociação prévia; no \textit {Rendezvous}, há uma etapa de \textit {handshake} entre emissor e receptor antes da transferência efetiva, eliminando a necessidade de \textit {buffers} intermediários}{figure.2.1}{}}
\citation{mpiCite,Rr:10,Wre:99}
\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Relação entre comunicação ponto a ponto e E/S paralela. No modelo centralizado, os resultados passam por um processo escritor; no modelo MPI-IO, os próprios processos escrevem diretamente no arquivo.}}{7}{figure.2.2}\protected@file@percent }
\newlabel{fig:mpi_protocolos_e_io}{{2.2}{7}{Relação entre comunicação ponto a ponto e E/S paralela. No modelo centralizado, os resultados passam por um processo escritor; no modelo MPI-IO, os próprios processos escrevem diretamente no arquivo}{figure.2.2}{}}
